<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vortexsign_tv">

    <!-- Deklarasi sebagai Android TV app — wajib agar muncul di home TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VortexsignTv"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Splash Screen: entry point pertama saat app dibuka -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:banner="@drawable/tv_banner"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VortexsignTv.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Launcher untuk HP/tablet biasa -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Launcher untuk Android TV — wajib agar muncul di home TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity: dijalankan setelah splash selesai -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.VortexsignTv" />

        <!-- Boot Receiver: auto-start saat TV dinyalakan / restart -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="1000">
                <!-- Standard Android boot -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Xiaomi / Mi Box / beberapa TV Android -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Auto-start setelah APK diupdate -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Boot Service: foreground service yang menjamin app terbuka saat boot -->
        <service
            android:name=".BootService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>